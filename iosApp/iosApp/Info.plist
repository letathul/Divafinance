<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Diva Finance</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>AccentColor</string>
    </dict>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <!-- Required by Compose Multiplatform; without it Compose throws on startup. -->
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Diva Finance uses local network to serve the browser-based dashboard on your device.</string>
    <!-- iOS counterparts of the CAMERA / ACCESS_FINE_LOCATION permissions the
         Android manifest declares; iOS terminates the app if these are missing. -->
    <key>NSCameraUsageDescription</key>
    <string>Diva Finance uses the camera to scan receipts.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Diva Finance uses your location to tag transactions on the spending map.</string>
    <!-- The target of every automation shortcut. `AutomationViewModel` mints
         `divafinance://automation/{id}` and the Siri suggestions registered by
         `IosShortcutRegistrar` open it; without this the scheme resolves to nothing. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.divafinance.app</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>divafinance</string>
            </array>
        </dict>
    </array>
    <!-- The activity types `IosShortcutRegistrar` donates to Siri, one per automation id.
         iOS will not hand back an activity whose type isn't declared here. -->
    <key>NSUserActivityTypes</key>
    <array>
        <string>quick_expense</string>
        <string>daily_summary</string>
        <string>budget_alert</string>
        <string>android_widget</string>
        <string>android_nfc</string>
        <string>ios_siri</string>
        <string>ios_shortcuts</string>
    </array>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
</dict>
</plist>
