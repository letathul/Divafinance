-- v2 -> v3
--
-- People and shared expenses. Every statement here is mirrored in DivaFinance.sq, which
-- is what fresh installs run via Schema.create(); this file is what existing installs run
-- via Schema.migrate(). verifyMigrations fails the build if the two disagree.
--
-- SQLite only permits NOT NULL on ADD COLUMN when a constant default is supplied, which
-- is why others_share defaults to 0.0 — existing rows are all fully the user's own spend.
-- The column lands at the end of the table, so DivaFinance.sq must declare it last too.
ALTER TABLE DivaTransaction ADD COLUMN others_share REAL NOT NULL DEFAULT 0.0;

CREATE TABLE Person (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    note TEXT,
    is_archived INTEGER NOT NULL DEFAULT 0,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL
);

CREATE TABLE LedgerEntry (
    id TEXT NOT NULL PRIMARY KEY,
    person_id TEXT NOT NULL REFERENCES Person(id),
    amount REAL NOT NULL,
    currency TEXT NOT NULL DEFAULT 'USD',
    kind TEXT NOT NULL,
    note TEXT,
    date TEXT NOT NULL,
    transaction_id TEXT REFERENCES DivaTransaction(id),
    created_at TEXT NOT NULL
);

CREATE INDEX IF NOT EXISTS idx_ledger_person ON LedgerEntry(person_id);
CREATE INDEX IF NOT EXISTS idx_ledger_date ON LedgerEntry(date);
