CREATE TABLE Account (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    type TEXT NOT NULL,
    currency TEXT NOT NULL DEFAULT 'USD',
    balance REAL NOT NULL DEFAULT 0.0,
    color TEXT,
    icon TEXT,
    is_active INTEGER NOT NULL DEFAULT 1,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL
);

CREATE TABLE CreditCard (
    id TEXT NOT NULL PRIMARY KEY,
    account_id TEXT NOT NULL REFERENCES Account(id),
    name TEXT NOT NULL,
    last_four TEXT,
    network TEXT NOT NULL DEFAULT 'OTHER',
    color TEXT NOT NULL DEFAULT '#1E1E2E',
    credit_limit REAL NOT NULL DEFAULT 0.0,
    current_balance REAL NOT NULL DEFAULT 0.0,
    statement_date INTEGER,
    due_date INTEGER,
    annual_fee REAL NOT NULL DEFAULT 0.0,
    is_active INTEGER NOT NULL DEFAULT 1,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL
);

CREATE TABLE RewardRule (
    id TEXT NOT NULL PRIMARY KEY,
    card_id TEXT NOT NULL REFERENCES CreditCard(id) ON DELETE CASCADE,
    category TEXT NOT NULL,
    multiplier REAL NOT NULL,
    reward_type TEXT NOT NULL,
    cap_amount REAL,
    cap_period TEXT,
    is_active INTEGER NOT NULL DEFAULT 1
);

CREATE TABLE DivaTransaction (
    id TEXT NOT NULL PRIMARY KEY,
    account_id TEXT NOT NULL REFERENCES Account(id),
    card_id TEXT,
    amount REAL NOT NULL,
    currency TEXT NOT NULL DEFAULT 'USD',
    category TEXT NOT NULL,
    subcategory TEXT,
    merchant_name TEXT,
    note TEXT,
    date TEXT NOT NULL,
    type TEXT NOT NULL,
    latitude REAL,
    longitude REAL,
    location_name TEXT,
    receipt_id TEXT,
    is_recurring INTEGER NOT NULL DEFAULT 0,
    created_at TEXT NOT NULL,
    -- The part of `amount` that other people owe back, from a split bill. `amount` stays
    -- the full figure the card was actually charged, so card balances stay correct;
    -- spending aggregates subtract this so only your own share counts as consumption.
    -- Set once when the split is created and never changed by repayments — being paid
    -- back does not retroactively make it your spending.
    -- Must be last: ALTER TABLE ADD COLUMN appends, and verifyMigrations compares shapes.
    others_share REAL NOT NULL DEFAULT 0.0
);

-- Every transaction query filters or sorts on date, and the list/graph screens filter on
-- category. Merchant is indexed for the distinct-merchant suggestion lookup and prefix
-- autocomplete (a leading-wildcard LIKE will not use it).
CREATE INDEX IF NOT EXISTS idx_txn_date ON DivaTransaction(date);
CREATE INDEX IF NOT EXISTS idx_txn_category ON DivaTransaction(category);
CREATE INDEX IF NOT EXISTS idx_txn_merchant ON DivaTransaction(merchant_name);

CREATE TABLE Receipt (
    id TEXT NOT NULL PRIMARY KEY,
    transaction_id TEXT REFERENCES DivaTransaction(id),
    image_path TEXT,
    ocr_text TEXT,
    merchant_name TEXT,
    total_amount REAL,
    date TEXT,
    status TEXT NOT NULL DEFAULT 'PENDING',
    created_at TEXT NOT NULL,
    -- Added in 3.sqm. ALTER TABLE ADD COLUMN appends, so these must stay last and in this
    -- order; see the note in 2.sqm.
    subtotal_amount REAL,
    tax_amount REAL,
    tip_amount REAL,
    currency TEXT,
    -- Pages 2..n of a multi-page scan, newline-separated. Page 1 stays in image_path so every
    -- existing reader keeps working and single-page receipts are unchanged on disk.
    page_paths TEXT
);

CREATE TABLE ReceiptLineItem (
    id TEXT NOT NULL PRIMARY KEY,
    receipt_id TEXT NOT NULL REFERENCES Receipt(id),
    -- Printed order on the receipt. Kept explicitly because the rows are rewritten wholesale
    -- when a review is saved and insertion order is not a guarantee.
    position INTEGER NOT NULL,
    description TEXT NOT NULL,
    quantity REAL,
    unit_price REAL,
    total_price REAL
);

CREATE INDEX IF NOT EXISTS idx_line_item_receipt ON ReceiptLineItem(receipt_id);

CREATE TABLE FeedPost (
    id TEXT NOT NULL PRIMARY KEY,
    type TEXT NOT NULL,
    title TEXT NOT NULL,
    body TEXT NOT NULL,
    transaction_id TEXT,
    metadata TEXT,
    created_at TEXT NOT NULL
);

CREATE TABLE UserSettings (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

CREATE TABLE GraphThreshold (
    id TEXT NOT NULL PRIMARY KEY,
    category TEXT NOT NULL,
    threshold_percent REAL NOT NULL,
    is_active INTEGER NOT NULL DEFAULT 1
);

-- Someone money is owed to or from. Local only — no contacts, no accounts, no sharing.
CREATE TABLE Person (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    note TEXT,
    -- People are archived, never deleted: PRAGMA foreign_keys is off across this app, so
    -- a hard delete would silently orphan their ledger rows rather than being refused.
    is_archived INTEGER NOT NULL DEFAULT 0,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL
);

-- One movement of money between the user and a person. `amount` is always positive; the
-- direction lives in `kind`, so a balance is the signed sum and partial repayments need
-- no special case. Settled means that sum is within half a minor unit of zero.
CREATE TABLE LedgerEntry (
    id TEXT NOT NULL PRIMARY KEY,
    person_id TEXT NOT NULL REFERENCES Person(id),
    amount REAL NOT NULL,
    currency TEXT NOT NULL DEFAULT 'USD',
    kind TEXT NOT NULL,
    note TEXT,
    date TEXT NOT NULL,
    -- Set when this came from a real spend. Also what groups the entries of one split,
    -- which is why there is no separate group id.
    transaction_id TEXT REFERENCES DivaTransaction(id),
    created_at TEXT NOT NULL
);

CREATE INDEX IF NOT EXISTS idx_ledger_person ON LedgerEntry(person_id);
CREATE INDEX IF NOT EXISTS idx_ledger_date ON LedgerEntry(date);
