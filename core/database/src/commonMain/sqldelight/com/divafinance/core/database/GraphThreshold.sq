selectAll:
SELECT * FROM GraphThreshold WHERE is_active = 1;

selectByCategory:
SELECT * FROM GraphThreshold WHERE category = ? AND is_active = 1;

insert:
INSERT INTO GraphThreshold(id, category, threshold_percent, is_active) VALUES (?, ?, ?, ?);

update:
UPDATE GraphThreshold SET category = ?, threshold_percent = ?, is_active = ? WHERE id = ?;

delete:
DELETE FROM GraphThreshold WHERE id = ?;
